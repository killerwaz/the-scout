# Copy to .env and fill in what you use. Never commit .env.

# Telegram bot (telegram_bot.py). Token from @BotFather; ID from `python telegram_bot.py whoami`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Local HTTP API for n8n (api_server.py). Generate with `python api_server.py make-token`.
SCOUT_API_TOKEN=

# Optional: Brave Search API key (free tier). Without it the free engines are used.
BRAVE_API_KEY=

# Optional: local model server (LM Studio or Ollama) for --brain local.
# SCOUT_LOCAL_URL=http://localhost:1234/v1
# SCOUT_LOCAL_MODEL=qwen/qwen3.5-9b
LM_API_TOKEN=

# Set in the shell, not here: SCOUT_ALLOW_PRIVATE, FETCHER_PROXIES, FETCHER_DEBUG, SCOUT_CLAUDE_CONFIG.
# See "Settings" in README.md.
